# --- Sanity (Studio où Tiko importe ses photos/vidéos) ---
# Crée un projet gratuit sur https://www.sanity.io/manage puis colle le Project ID.
# Laissé vide → le site tourne sur le contenu de démo (lib/seed.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Secret du webhook Sanity → rafraîchissement instantané après "Publish" (/api/revalidate)
SANITY_REVALIDATE_SECRET=

# --- Formulaire de contact (https://resend.com) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optionnel, une fois le domaine vérifié dans Resend
CONTACT_FROM_EMAIL="TikoPix <hello@tikopix.com>"

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://tikopix.com
